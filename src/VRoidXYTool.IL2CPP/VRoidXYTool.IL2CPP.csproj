<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BepInExRoot Condition="'$(BepInExRoot)' == ''">../../.local/bepinex-788/BepInEx</BepInExRoot>
    <InteropRoot Condition="'$(InteropRoot)' == ''">../../.local/VRoidStudio/BepInEx/interop</InteropRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(BepInExRoot)/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExRoot)/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExRoot)/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(InteropRoot)/Il2Cppmscorlib.dll" Private="false" Aliases="il2cpp" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(InteropRoot)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExRoot)/core/BepInEx.Unity.IL2CPP.dll')" Text="Set BepInExRoot to the BepInEx directory of the pinned IL2CPP runtime. See docs/IL2CPP_BOOTSTRAP.md." />
    <Error Condition="!Exists('$(InteropRoot)/UnityEngine.CoreModule.dll')" Text="Run the isolated application with BepInEx once to generate interop assemblies, then set InteropRoot. See docs/IL2CPP_BOOTSTRAP.md." />
  </Target>
</Project>
